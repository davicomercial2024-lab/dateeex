# Banco de dados Turso
TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
TURSO_AUTH_TOKEN="seu_token_de_autenticacao"

# Banco local usado pelo Prisma CLI para gerar migrations
LOCAL_DATABASE_URL="file:./prisma/dev.db"

# Seguranca da sessao Datex
# Gere um valor aleatorio forte, por exemplo com: openssl rand -base64 32
JWT_SECRET="gere_um_segredo_forte_com_no_minimo_32_caracteres"

# Integracao oficial Mercado Livre OAuth2
MERCADO_LIVRE_CLIENT_ID="seu_client_id"
MERCADO_LIVRE_CLIENT_SECRET="seu_client_secret"
MERCADO_LIVRE_REDIRECT_URI="https://seu-dominio-publico/api/auth/mercadolivre/callback"

# Webhook Mercado Livre
# Envie este valor no header X-Datex-Webhook-Secret ou no parametro ?secret=...
MERCADO_LIVRE_WEBHOOK_SECRET="seu_webhook_secret"

# IA
OPENAI_API_KEY="sua_chave_openai"
